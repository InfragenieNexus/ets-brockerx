{
  "dashboard": {
    "id": null,
    "title": "4 Golden Signals - Spring Boot",
    "tags": [
      "golden",
      "spring",
      "prometheus"
    ],
    "timezone": "browser",
    "schemaVersion": 37,
    "version": 1,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "type": "graph",
        "title": "Latence (/api/v1/user/{id})",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_sum{uri=\"/api/v1/user/{id}\"}[1m]) / rate(http_server_requests_seconds_count{uri=\"/api/v1/user/{id}\"}[1m])",
            "legendFormat": "avg latency",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "type": "graph",
        "title": "Trafic (RPS)",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (uri)",
            "legendFormat": "{{uri}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "type": "graph",
        "title": "Erreurs 4xx/5xx",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "sum(rate(http_server_requests_seconds_count{status=~\"4..\"}[1m])) by (uri)",
            "legendFormat": "4xx - {{uri}}",
            "refId": "A"
          },
          {
            "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m])) by (uri)",
            "legendFormat": "5xx - {{uri}}",
            "refId": "B"
          }
        ]
      },
      {
        "id": 4,
        "type": "graph",
        "title": "Saturation CPU / RAM / Threads",
        "datasource": "${DS_PROMETHEUS}",
        "targets": [
          {
            "expr": "process_cpu_usage",
            "legendFormat": "CPU JVM",
            "refId": "A"
          },
          {
            "expr": "sum(jvm_memory_used_bytes{area=\"heap\"}) / sum(jvm_memory_max_bytes{area=\"heap\"})",
            "legendFormat": "Heap RAM %",
            "refId": "B"
          },
          {
            "expr": "jvm_threads_live_threads",
            "legendFormat": "Threads",
            "refId": "C"
          }
        ]
      }
    ]
  }
}
